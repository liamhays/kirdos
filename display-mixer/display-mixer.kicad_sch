	(text "If we want to upgrade the mainboard later on down\nthe line, we need to keep components off of the display mixer.\nNote that this connector has enough pins or a future revision\nto separate the bar display and LS021 lines.\n\nINTB and PCLK are the same pin but muxed on the mainboard.\n\nName scheme: bar display/LS021"
		(exclude_from_sim no)
		(at 173.482 113.284 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0cd608d9-cf53-4cdd-ad58-fb491c6aa9b3")
	)
	(text "It's just MOSI, we're never going\nto read from the display chip"
		(exclude_from_sim no)
		(at 20.828 103.632 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "65def965-5135-454c-99a8-7ff58eda17a0")
	)
	(text "Color in format 0bRRRGGGBB,\nbut we don't actually know\nthe pin ordering or the bit\nsignificance on the ER-TFT062.\nThis board stays unrouted\nuntil we can get that."
		(exclude_from_sim no)
		(at 16.002 20.574 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "70836755-7d7b-491c-aa90-d130a0700860")
	)
	(text "41 and 42 are the shield"
		(exclude_from_sim no)
		(at 265.176 157.226 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "91a9144b-2e83-466a-9817-ebf28fe03f20")
	)
	(text "The LS021 is rated for 3.3V max, 3.2V typ,\nbut the rest of the system is 3.3V, so\nwe're going to push it."
		(exclude_from_sim no)
		(at 137.414 21.082 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c7a74b1d-6ce3-4ce9-a9f7-bbee6ab805c9")
	)
